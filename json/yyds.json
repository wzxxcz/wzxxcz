from flask import Flask, jsonify, request
import json

# 您提供的JSON数据
your_json_data = {
    "SiteUrl": "https://tv.yydsys.top",
    ... # 您原始提供的完整JSON数据
}

app = Flask(__name__)

@app.route('/api/get_filters', methods=['GET'])
def get_filters():
    """
    获取指定类型的筛选条件API接口
    参数：type_id - 分类ID（例如：1，2，3，4，5）
    """
    try:
        # 从请求参数中获取type_id，例如 /api/get_filters?type_id=1
        type_id = request.args.get('type_id', type=str)
        
        if not type_id:
            return jsonify({"error": "Missing parameter: type_id"}), 400
        
        # 在Filters中查找对应的筛选条件
        filters_for_type = your_json_data["Filters"].get(type_id)
        
        if filters_for_type is None:
            return jsonify({"error": f"Invalid type_id: {type_id}. Available types: {list(your_json_data['Filters'].keys())}"}), 404
        
        # 构建返回数据，可以加入一些站点信息
        response_data = {
            "siteInfo": {
                "siteUrl": your_json_data["SiteUrl"],
                "siteName": your_json_data["SiteName"],
                "domains": your_json_data["Domains"]
            },
            "filters": filters_for_type
        }
        
        return jsonify(response_data), 200
    
    except Exception as e:
        # 记录日志等更复杂的错误处理可以在这里添加
        return jsonify({"error": "Internal server error", "details": str(e)}), 500

@app.route('/api/get_all_classes', methods=['GET'])
def get_all_classes():
    """
    获取所有影视分类信息
    """
    try:
        return jsonify(your_json_data["Classes"]), 200
    except Exception as e:
        return jsonify({"error": "Internal server error", "details": str(e)}), 500

if __name__ == '__main__':
    app.run(debug=True) # 生产环境应关闭debug模式
