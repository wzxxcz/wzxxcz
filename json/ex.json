{
    "SiteConfig": {
        "BaseSiteUrl": "https://xhww.net",  // 主站点基础URL（原SiteUrl为空，补充核心域名）
        "ValidDomains": [  // 过滤无效/重复域名，保留HTTPS优先
            "https://xhww.net",
            "https://www.xhww.net",
            "https://xiaoer.5568.eu.org",
            "https://erxiaofn.click",
            "https://erxiaofn.site"
            // 移除HTTP域名（建议统一HTTPS）、纯IP（需端口/路径）及非核心域名
        ],
        "SiteInfo": {
            "Keyword": "ex",       // 站点关键词
            "Name": "二小"          // 站点名称
        },
        "ContentClasses": [       // 内容分类（原Classes重命名，明确层级）
            {
                "type_id": 1,
                "type_name": "电影",
                "filter_key": "movie"  // 关联筛选条件的唯一标识（原Filters键值不直观，优化为语义化）
            },
            {
                "type_id": 2,
                "type_name": "剧集",
                "filter_key": "tv"
            },
            {
                "type_id": 3,
                "type_name": "动漫",
                "filter_key": "anime"
            },
            {
                "type_id": 17,
                "type_name": "综艺",
                "filter_key": "variety"
            }
        ],
        "FilterRules": {          // 筛选规则（原Filters按分类关联，结构更清晰）
            "movie": [            // 对应电影（type_id=1）的筛选条件
                {
                    "name": "类型",
                    "key": "type",
                    "values": [
                        {"v": "25", "n": "科幻"},
                        {"v": "26", "n": "战争"},
                        {"v": "27", "n": "爱情"},
                        {"v": "28", "n": "恐怖"},
                        {"v": "29", "n": "院线"},
                        {"v": "30", "n": "其他"}
                    ]
                },
                {
                    "name": "剧情",
                    "key": "class",
                    "values": [/* 原内容保留，略 */]
                },
                // 其他筛选条件（地区、语言、时间等）结构同上...
            ],
            "tv": [               // 对应剧集（type_id=2）的筛选条件
                // 类似电影结构，适配剧集筛选...
            ],
            "anime": [            // 对应动漫（type_id=3）的筛选条件
                // 原type_id=3的筛选条件移至此处...
            ],
            "variety": [          // 对应综艺（type_id=17）的筛选条件
                // 原type_id=17的筛选条件移至此处...
            ]
        },
        "PlayerConfig": {         // 新增播放功能基础配置（关键补充）
            "SupportedFormats": ["mp4", "m3u8", "flv"],  // 支持的视频格式
            "PlayerUrl": "/player.html",                 // 播放页路由（需后端配合）
            "ApiEndpoint": {                             // 后端接口地址（示例）
                "GetVideoList": "/api/get_list",         // 获取视频列表接口
                "GetPlayUrl": "/api/get_play_url"        // 获取播放地址接口
            }
        }
    }
}
