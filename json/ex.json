{
    "SiteConfig": {
        "BaseSiteUrl": "https://xhww.net",
        "ValidDomains": [
            "https://xhww.net",
            "https://www.xhww.net",
            "https://xiaoer.5568.eu.org",
            "https://erxiaofn.click",
            "https://erxiaofn.site"
        ],
        "SiteInfo": {
            "Name": "二小",
            "Keyword": "ex"
        },
        // 分类数据（明确每个分类的ID、名称、关联的筛选规则）
        "Categories": [
            {
                "id": 1,          // 分类唯一ID（对应原type_id）
                "name": "电影",    // 用户可见的分类名称
                "filterKey": "1"  // 关联筛选规则的键（必须与Filters中的键一致）
            },
            {
                "id": 2,
                "name": "剧集",
                "filterKey": "2"
            },
            {
                "id": 3,
                "name": "动漫",
                "filterKey": "3"
            },
            {
                "id": 17,
                "name": "综艺",
                "filterKey": "17"  // 原Filters中无17，需补充对应规则（见下方Filters）
            }
        ],
        // 筛选规则（键为分类ID，确保与Categories的filterKey完全一致）
        "Filters": {
            "1": [  // 电影（对应Categories中id=1）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [
                        {"v": "25", "n": "科幻"},
                        {"v": "26", "n": "战争"},
                        {"v": "27", "n": "爱情"},
                        {"v": "28", "n": "恐怖"},
                        {"v": "29", "n": "院线"},
                        {"v": "30", "n": "其他"}
                    ]
                },
                {
                    "name": "地区",
                    "key": "area",
                    "options": [
                        {"v": "内地", "n": "内地"},
                        {"v": "韩国", "n": "韩国"},
                        {"v": "香港", "n": "香港"},
                        {"v": "台湾", "n": "台湾"},
                        {"v": "日本", "n": "日本"},
                        {"v": "美国", "n": "美国"}
                    ]
                },
                {
                    "name": "时间",
                    "key": "year",
                    "options": [
                        {"v": "2024", "n": "2024"},
                        {"v": "2023", "n": "2023"},
                        // 其他年份...
                    ]
                }
            ],
            "2": [  // 剧集（对应Categories中id=2）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [
                        {"v": "31", "n": "国产剧"},
                        {"v": "32", "n": "欧美剧"},
                        {"v": "33", "n": "日韩剧"},
                        {"v": "34", "n": "港台剧"},
                        {"v": "35", "n": "其他剧"}
                    ]
                },
                // 地区、时间等筛选条件...
            ],
            "3": [  // 动漫（对应Categories中id=3）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [
                        {"v": "36", "n": "国产动漫"},
                        {"v": "37", "n": "日韩动漫"},
                        {"v": "38", "n": "欧美动漫"}
                    ]
                },
                // 地区、时间等筛选条件...
            ],
            "17": [  // 综艺（原Filters中无17，现补充）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [
                        {"v": "39", "n": "国产综艺"},
                        {"v": "40", "n": "其他综艺"}
                    ]
                },
                // 时间、字母查找等筛选条件...
            ]
        }
    }
}
