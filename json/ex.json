{
    "SiteConfig": {
        "BaseSiteUrl": "https://xhww.net",
        "ValidDomains": [
            "https://xhww.net",
            "https://www.xhww.net",
            "https://xiaoer.5568.eu.org",
            "https://erxiaofn.click",
            "https://erxiaofn.site"
        ],
        "SiteInfo": {
            "Keyword": "ex",
            "Name": "二小"
        },
        // 核心修正：分类模块独立且明确，直接关联内容类型
        "ContentCategories": [
            {
                "id": 1,                  // 分类唯一ID（对应原type_id）
                "name": "电影",           // 分类名称（对应原type_name）
                "alias": "movie",         // 分类别名（用于接口/路由标识）
                "filterRules": "movie"    // 关联筛选规则（对应FilterRules中的键）
            },
            {
                "id": 2,
                "name": "剧集",
                "alias": "tv",
                "filterRules": "tv"
            },
            {
                "id": 3,
                "name": "动漫",
                "alias": "anime",
                "filterRules": "anime"
            },
            {
                "id": 17,
                "name": "综艺",
                "alias": "variety",
                "filterRules": "variety"
            }
        ],
        // 筛选规则按分类别名组织，与ContentCategories强关联
        "FilterRules": {
            "movie": [  // 对应电影分类的筛选条件（alias=movie）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [  // 更直观的字段名（原"value"→"options"）
                        {"value": "25", "label": "科幻"},
                        {"value": "26", "label": "战争"},
                        {"value": "27", "label": "爱情"},
                        {"value": "28", "label": "恐怖"},
                        {"value": "29", "label": "院线"},
                        {"value": "30", "label": "其他"}
                    ]
                },
                {
                    "name": "地区",
                    "key": "area",
                    "options": [
                        {"value": "内地", "label": "内地"},
                        {"value": "韩国", "label": "韩国"},
                        {"value": "香港", "label": "香港"},
                        {"value": "台湾", "label": "台湾"},
                        {"value": "日本", "label": "日本"},
                        {"value": "美国", "label": "美国"}
                    ]
                },
                // 其他筛选条件（剧情、语言、时间等）同理...
            ],
            "tv": [     // 对应剧集分类的筛选条件（alias=tv）
                {
                    "name": "类型",
                    "key": "type",
                    "options": [
                        {"value": "31", "label": "国产剧"},
                        {"value": "32", "label": "欧美剧"},
                        {"value": "33", "label": "日韩剧"},
                        {"value": "34", "label": "港台剧"},
                        {"value": "35", "label": "其他剧"}
                    ]
                },
                // 地区、语言等筛选条件与电影类似...
            ],
            "anime": [  // 对应动漫分类的筛选条件（alias=anime）
                // 原type_id=3的筛选条件（类型含日韩/欧美/国产动漫）...
            ],
            "variety": [ // 对应综艺分类的筛选条件（alias=variety）
                // 原type_id=17的筛选条件（类型含国产/其他综艺）...
            ]
        },
        "PlayerConfig": {
            "SupportedFormats": ["mp4", "m3u8", "flv"],
            "PlayerUrl": "/player.html",
            "ApiEndpoints": {
                "getList": "/api/list",      // 获取分类内容列表接口（需传递分类alias）
                "getPlayUrl": "/api/play"    // 获取播放地址接口
            }
        }
    }
}
